rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzione per verificare se l'utente è un Founder
    function isFounder() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Founder";
    }

    // 1. PERSONAGGI
    match /characters/{charId} {
      allow read, create: if request.auth != null;
      
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isFounder()
      );
    }

    // 2. UTENTI
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if isFounder(); 
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2bis. CODICI AMICO - documento "leggero" (uid + username) per la ricerca via
    // friendCode senza dover interrogare (query/list) la collection users, che è
    // riservata ai Founder. Il get() per ID documento e' permesso a ogni utente loggato;
    // la creazione e' permessa solo per il proprio uid, cosi' nessuno puo' registrare
    // un friendCode che punta a un altro utente.
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 3. AMICIZIE E CAMPAGNE
    match /friendships/{friendId} { allow read, write: if request.auth != null; }
    match /campagne/{campId} { allow read, write: if request.auth != null; }
    
    // 4. CHAT E MESSAGGI
    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow write, create: if request.auth != null;
      
      match /messages/{msgId} { 
        allow read, write: if request.auth != null; 
      }
    }

    // Default: blocca tutto il resto
    match /{document=**} { allow read, write: if false; }
  }
}
